# Copy this file to .env and replace both placeholders before starting Docker Compose.
# Use a long random alphanumeric value for POSTGRES_PASSWORD (URL-safe).
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
FRONTEND_ORIGINS=http://localhost:8080
VITE_API_URL=/api
